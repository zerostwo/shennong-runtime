# Images default to the public zerostwo/*:latest repositories. Set the optional
# SHENNONG_*_IMAGE overrides to immutable digests for production rollbacks.

# Dedicated rootless executor account and its private socket.
SHENNONG_RUNTIME_UID=1001
SHENNONG_RUNTIME_GID=1001
SHENNONG_ROOTLESS_DOCKER_SOCKET=/run/user/1001/shennong-runtime-docker/docker.sock
SHENNONG_ROOTLESSKIT_STATE_DIR=/run/user/1001/shennong-runtime-rootlesskit

# Exact host-side gateway of the private Shennong control bridge. Never use
# 0.0.0.0 or a public/LAN address. OS calls this address from its control network.
SHENNONG_RUNTIME_LISTEN=172.30.0.1:7000
SHENNONG_OS_AUTH_COOKIE_NAMES=__Host-shennong_session
SHENNONG_MAX_CONCURRENT_JOBS=4
SHENNONG_MAX_CONCURRENT_SESSIONS=2
SHENNONG_MONITOR_INTERVAL_MS=2000

# Ed25519 verification key exported by Shennong OS; no private key belongs here.
SHENNONG_OS_JWT_PUBLIC_KEY_FILE=./secrets/shennong-os-runtime-jwt.pub
